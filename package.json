{
  "name": "timoteo",
  "version": "0.1.0",
  "description": "Mapa colaborativo e de código aberto para evangelizar em conjunto.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/timoteo.test.js",
    "start": "python -m http.server 5173",
    "check": "npm run lint",
    "banco:subir": "docker compose -f supabase/teste-local/docker-compose.yml up -d --wait",
    "banco:parar": "docker compose -f supabase/teste-local/docker-compose.yml down",
    "test:banco": "node --test supabase/teste-local/testar.mjs",
    "test:e2e": "node --test supabase/teste-local/e2e.mjs",
    "test:tudo": "npm test && npm run test:pwa && npm run test:banco && npm run test:e2e",
    "test:pwa": "node --test tests/pwa.e2e.mjs",
    "legal": "node scripts/gerar_legal.mjs",
    "checar:publicacao": "node scripts/checar_publicacao.mjs",
    "lint": "eslint . --max-warnings=0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurha1204/timoteo.git"
  },
  "homepage": "https://github.com/arthurha1204/timoteo#readme",
  "bugs": {
    "url": "https://github.com/arthurha1204/timoteo/issues"
  },
  "keywords": [
    "evangelismo",
    "missoes",
    "mapa",
    "ibge",
    "brasil",
    "open-source"
  ],
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.13.0"
  }
}
